<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="twp_bs_quote_view_form" model="ir.ui.view">
        <field name="name">twp.bid.spec.quote.form</field>
        <field name="model">twp.bid.spec.quote</field>
        <field name="arch" type="xml">
            <form string="Bid">
                <header>
                    <button name="action_twp_bs_log_touch" string="Log touch" type="object" class="oe_highlight"
                            invisible="result not in ('not_quoted', 'pending')"/>
                    <field name="result" widget="statusbar" statusbar_visible="not_quoted,pending,won"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Who">
                            <field name="job_id" readonly="id" options="{'no_create': True}"/>
                            <field name="lead_id"/>
                            <field name="partner_id"
                                   context="{'default_is_company': True, 'twp_bs_role_kind': 'contractor'}"/>
                            <field name="source_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Our bid">
                            <field name="quoted_as"/>
                            <field name="model_quoted"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="margin" widget="percentage"/>
                            <field name="gross_profit"/>
                        </group>
                        <group string="Dates">
                            <field name="first_contact_date"/>
                            <field name="quote_date"/>
                            <field name="last_contact_date"/>
                        </group>
                        <group string="Outcome">
                            <field name="result"/>
                            <field name="result_override"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="twp_bs_quote_view_list" model="ir.ui.view">
        <field name="name">twp.bid.spec.quote.list</field>
        <field name="model">twp.bid.spec.quote</field>
        <field name="arch" type="xml">
            <list string="Bids">
                <field name="lead_id"/>
                <field name="product_line_id"/>
                <field name="partner_id"/>
                <field name="source_id" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="quoted_as" optional="hide"/>
                <field name="quote_date"/>
                <field name="last_contact_date" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="margin" widget="percentage" optional="hide"/>
                <field name="gross_profit" optional="hide" sum="GP"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'won'"
                       decoration-danger="result in ('lost_contractor', 'lost_mfr', 'project_dead')"
                       decoration-warning="result == 'awarded_update'"
                       decoration-info="result == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="twp_bs_quote_view_search" model="ir.ui.view">
        <field name="name">twp.bid.spec.quote.search</field>
        <field name="model">twp.bid.spec.quote</field>
        <field name="arch" type="xml">
            <search string="Bids">
                <field name="lead_id"/>
                <field name="partner_id"/>
                <field name="product_line_id"/>
                <field name="user_id"/>
                <filter string="My bids" name="mine" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Not bid yet" name="not_quoted" domain="[('result', '=', 'not_quoted')]"/>
                <filter string="Pending" name="pending" domain="[('result', '=', 'pending')]"/>
                <filter string="Awarded - Update" name="awarded_update" domain="[('result', '=', 'awarded_update')]"/>
                <filter string="Won" name="won" domain="[('result', '=', 'won')]"/>
                <filter string="Lost" name="lost" domain="[('result', 'in', ('lost_contractor', 'lost_mfr'))]"/>
                <separator/>
                <filter string="Proactive" name="proactive" domain="[('source_kind', '=', 'proactive')]"/>
                <filter string="Inbound" name="inbound" domain="[('source_kind', '=', 'inbound')]"/>
                <separator/>
                <filter string="Bid sent" name="quote_date" date="quote_date"/>
                <filter string="Reporting date" name="reporting_date" date="reporting_date"/>
                <group>
                    <filter string="Project" name="group_lead" context="{'group_by': 'lead_id'}"/>
                    <filter string="Job" name="group_job" context="{'group_by': 'job_id'}"/>
                    <filter string="Contractor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Bid by" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Result" name="group_result" context="{'group_by': 'result'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source_id'}"/>
                    <filter string="Outreach" name="group_source_kind" context="{'group_by': 'source_kind'}"/>
                    <filter string="Product line" name="group_product_line" context="{'group_by': 'product_line_id'}"/>
                    <filter string="Engineer" name="group_engineer" context="{'group_by': 'engineer_id'}"/>
                    <filter string="Lead service" name="group_lead_source" context="{'group_by': 'lead_source_id'}"/>
                    <filter string="Reporting month" name="group_month" context="{'group_by': 'reporting_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_twp_bs_quote" model="ir.actions.act_window">
        <field name="name">Bids</field>
        <field name="res_model">twp.bid.spec.quote</field>
        <field name="view_mode">list,form,pivot,graph,activity</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bids yet</p>
            <p>A bid is one contractor's price on one job. Log them from the project.</p>
        </field>
    </record>
</odoo>
