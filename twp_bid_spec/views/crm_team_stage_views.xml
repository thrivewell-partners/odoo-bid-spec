<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_view_form_twp_bs" model="ir.ui.view">
        <field name="name">crm.team.form.twp.bid.spec</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options_active']" position="inside">
                <span name="twp_bid_spec">
                    <field name="twp_bs_enabled"/>
                    <label for="twp_bs_enabled"/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="crm_stage_form_twp_bs" model="ir.ui.view">
        <field name="name">crm.stage.form.twp.bid.spec</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <field name="is_won" position="after">
                <field name="twp_bs_step"/>
            </field>
        </field>
    </record>

    <record id="crm_stage_tree_twp_bs" model="ir.ui.view">
        <field name="name">crm.stage.list.twp.bid.spec</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_tree"/>
        <field name="arch" type="xml">
            <field name="is_won" position="after">
                <field name="twp_bs_step" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
